{
  "routes": [
    { "route": "/demo", "rewrite": "/index.html", "headers": { "Cache-Control": "no-cache" } },
    { "route": "/index.html", "allowedRoles": ["anonymous"], "headers": { "Cache-Control": "no-cache" } },
    { "route": "/privacy", "redirect": "/privacy/", "statusCode": 301 },
    { "route": "/terms", "redirect": "/terms/", "statusCode": 301 },
    { "route": "/", "allowedRoles": ["anonymous"], "headers": { "Cache-Control": "no-cache" } },
    { "route": "/privacy/*", "allowedRoles": ["anonymous"] },
    { "route": "/terms/*", "allowedRoles": ["anonymous"] },
    { "route": "/assets/index-*", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "route": "/assets/pdf.worker.min-*", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "route": "/assets/pdf-*", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "route": "/assets/*", "allowedRoles": ["anonymous"] },
    { "route": "/icons/*", "allowedRoles": ["anonymous"] },
    { "route": "/icon.svg", "allowedRoles": ["anonymous"] },
    { "route": "/legal.css", "allowedRoles": ["anonymous"] },
    { "route": "/legal.js", "allowedRoles": ["anonymous"] },
    { "route": "/404.html", "allowedRoles": ["anonymous"] },
    { "route": "/manifest.webmanifest", "allowedRoles": ["anonymous"] },
    { "route": "/sw.js", "allowedRoles": ["anonymous"], "headers": { "Cache-Control": "no-cache" } },
    { "route": "/offline.html", "allowedRoles": ["anonymous"] },
    { "route": "/robots.txt", "allowedRoles": ["anonymous"] },
    { "route": "/sitemap.xml", "allowedRoles": ["anonymous"] },
    { "route": "/*", "statusCode": 404 }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/*"]
  },
  "responseOverrides": {
    "404": { "rewrite": "/404.html" }
  },
  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests",
    "Permissions-Policy": "accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "mimeTypes": {
    ".webmanifest": "application/manifest+json",
    ".mjs": "text/javascript"
  }
}
